# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.

# YouTube (live)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Google Analytics 4 (live). The service account needs the Viewer role on the GA4 property.
GA4_PROPERTY_ID=
# local development: path to the service-account JSON key (keep it outside the project)
GA4_KEY_FILE=
# hosting alternative to the key file: the same two fields as variables
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# Meta: Facebook + Instagram (live sync not built yet, see README -> Handover)
META_PAGE_ID=
META_IG_USER_ID=
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
# Meta Ads: ad account ID (with or without the act_ prefix) and a System User token with the ads_read permission.
# If META_ADS_ACCESS_TOKEN is empty, META_ACCESS_TOKEN is used instead.
META_AD_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=

# Optional: Graph API version (default v23.0)
# META_GRAPH_VERSION=v23.0
